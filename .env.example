# Copy to .env and pick ONE.

# Daily lab work: Ollama running on Windows (reached from WSL via mirrored networking)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Portable / CI: containerized Ollama (start with --profile ollama)
# OLLAMA_BASE_URL=http://ollama:11434

# Model used by HelpBot, DocBot, and MailAgent
MODEL_NAME=llama3.2:3b

# Your Python apps run in WSL, not Docker, so they use this URL instead:
#   host Ollama:      http://localhost:11434
#   container Ollama: http://localhost:11435
APP_OLLAMA_URL=http://localhost:11434
